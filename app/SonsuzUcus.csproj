    <EmbeddedResource Include="wwwroot\game\assets\audio\magnet.wav" LogicalName="SonsuzUcus.audio.magnet.wav" />
    <EmbeddedResource Include="wwwroot\game\assets\audio\music_arcade_loop.wav" LogicalName="SonsuzUcus.audio.music_arcade_loop.wav" />
    <EmbeddedResource Include="wwwroot\game\assets\audio\perfect.wav" LogicalName="SonsuzUcus.audio.perfect.wav" />
    <EmbeddedResource Include="wwwroot\game\assets\audio\gate_pass.wav" LogicalName="SonsuzUcus.audio.gate_pass.wav" />
    <EmbeddedResource Include="wwwroot\game\assets\audio\stage_complete.wav" LogicalName="SonsuzUcus.audio.stage_complete.wav" />
    <EmbeddedResource Include="wwwroot\game\assets\audio\shield.wav" LogicalName="SonsuzUcus.audio.shield.wav" />
    <EmbeddedResource Include="wwwroot\game\assets\audio\tap.wav" LogicalName="SonsuzUcus.audio.tap.wav" />
    <EmbeddedResource Include="wwwroot\game\assets\audio\thrust_on.wav" LogicalName="SonsuzUcus.audio.thrust_on.wav" />
    <EmbeddedResource Include="wwwroot\game\assets\audio\wall_hit.wav" LogicalName="SonsuzUcus.audio.wall_hit.wav" />
    <EmbeddedResource Include="wwwroot\game\assets\audio\warn.wav" LogicalName="SonsuzUcus.audio.warn.wav" />

  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.0" />
    <PackageReference Include="Xamarin.GooglePlayServices.Ads" Version="125.4.0.2" Condition="'$(TargetFramework)' == 'net10.0-android'" />
  </ItemGroup>

</Project>

